<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>freq_change</name>
  <version>0.0.0</version>
  <description>The freq_change package</description>
  
  <maintainer email="nk@todo.todo">nk</maintainer>
  <license>TODO</license>

  <!-- 构建工具依赖（ROS 2使用ament_cmake） -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- 编译依赖 -->
  <depend>rclcpp</depend>       <!-- 替代roscpp -->
  <depend>rclpy</depend>        <!-- 替代rospy -->
  <depend>std_msgs</depend>     <!-- 保留标准消息 -->
  <depend>bodyctrl_msgs</depend> <!-- 保留自定义消息 -->
  <depend>aearm_traj_test</depend> <!-- 保留原有依赖 -->

  <!-- 测试依赖 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 构建导出配置 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
    