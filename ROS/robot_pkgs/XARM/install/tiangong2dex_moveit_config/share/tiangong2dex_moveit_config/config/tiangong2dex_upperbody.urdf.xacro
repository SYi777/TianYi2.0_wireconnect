<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tiangong2dex_upperbody">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tiangong2dex_upperbody urdf file -->
    <xacro:include filename="$(find tiangong2dex_description)/urdf/tiangong2dex_upperbody.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tiangong2dex_upperbody.ros2_control.xacro" />


    <xacro:tiangong2dex_upperbody_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
