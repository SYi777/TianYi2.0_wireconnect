<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tianyi2.0_complete">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tianyi2.0_complete urdf file -->
    <xacro:include filename="$(find tianyi2_description)/urdf/tianyi2.0_complete_with_hands.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tianyi2.0_complete.ros2_control.xacro" />


    <xacro:tianyi2_complete_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
