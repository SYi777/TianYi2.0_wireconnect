<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tianyi2_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tianyi2_description urdf file -->
    <xacro:include filename="$(find tianyi2_description)/urdf/tianyi2_description.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tianyi2_description.ros2_control.xacro" />


    <xacro:tianyi2_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
