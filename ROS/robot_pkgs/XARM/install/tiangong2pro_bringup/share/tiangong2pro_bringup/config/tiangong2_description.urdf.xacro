<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tianyi2_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="hardware" default="sim" />

    <!-- Import tianyi2_description urdf file -->
    <xacro:include filename="$(find tiangong2_description)/urdf/tiangong2pro_upperbody.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tiangong2_description.ros2_control.xacro" />

    <xacro:tiangong2_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)" hardware="$(arg hardware)"/>

</robot>
