#!/usr/bin/env python3
import argparse
import xrocs.core.main as xrocs


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run xROCS with the specified mode and config file.")
    parser.add_argument("--mode", type=str, help="The mode to use. Available modes: data_collect, check_h5_file_duplicate, vis_h5_master_puppet_joints, vis_h5_camera_images, launch_pyrealsense_zmq_server.")
    parser.add_argument("--config_path", type=str, default="", help="The path to the config file.")
    parser.add_argument("--expected_count", type=int, default=1, help="Num of camera.")
    parser.add_argument("--h5_file_path", type=str, default="", help="The path to the h5 file.")
    parser.add_argument("--output_dir", type=str, default=".", help="The output directory.")
    parser.add_argument("--name", type=str, default="", help="The name of the output file.")
    parser.add_argument("--title", type=str, default="", help="The title of the plot.")
    parser.add_argument("--scale_mode", type=str, nargs="?", default="fixed_scale", help="Y axis scale mode: fixed_scale or adaptive_scale.")
    parser.add_argument("--cameras", type=str, default=None, help="Comma-separated list of cameras to extract images from (e.g., 'camera_left,camera_top').")

    args = parser.parse_args()
    xrocs.main(args)